{
	"info": {
		"_postman_id": "7a35e4d2-f67f-4cce-8f96-e6d249f328b3",
		"name": "Smart Logistics Platform (SLP) - API Collection",
		"description": "Bộ sưu tập APIs kiểm thử nghiệp vụ cốt lõi dành cho dự án Smart Logistics Platform.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
