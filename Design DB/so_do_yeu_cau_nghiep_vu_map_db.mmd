    classDef actor     fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000,font-weight:bold
    classDef inputOrd  fill:#FFFFFF,stroke:#333333,stroke-width:1.5px,color:#000000
    classDef inputPkg  fill:#F5F5F5,stroke:#333333,stroke-width:1.5px,color:#000000
    classDef inputScan fill:#F5F5F5,stroke:#333333,stroke-width:1.5px,color:#000000
    classDef decision  fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000,font-weight:bold
    classDef ward      fill:#F0F0F0,stroke:#333333,stroke-width:1.5px,color:#000000
    classDef prov      fill:#D9D9D9,stroke:#333333,stroke-width:1.5px,color:#000000,font-weight:bold
    classDef sort      fill:#BFBFBF,stroke:#000000,stroke-width:2px,color:#000000,font-weight:bold
