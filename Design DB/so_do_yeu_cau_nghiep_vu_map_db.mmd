flowchart TB
    KH["CUSTOMER"] -- "1. CUSTOMER: Cung cấp thông tin đơn hàng" --> INFO_ORDER["THÔNG TIN ĐƠN HÀNG & ĐỊA CHỈ<br>====================================<br>   · Họ tên &amp; SĐT Người gửi / Người nhận<br>   · Địa chỉ lấy &amp; Địa chỉ giao hàng<br>   · Loại dịch vụ &amp; Khung giờ hẹn<br>   · Tiền thu hộ COD &amp; Phí vận chuyển<br>===================================="]
    INFO_ORDER -- "2. CUSTOMER: Nhập thông tin kiện hàng" --> INFO_PKG["THÔNG TIN KIỆN HÀNG<br>====================================<br>   · Kích thước (Dài x Rộng x Cao cm)<br>   · Trọng lượng thực tế (kg)<br>   · Tên &amp; Mô tả hàng hóa, Giá trị khai báo<br>   · Yêu cầu đặc biệt (Dễ vỡ / Nhiệt độ)<br>   · Loại xe vận chuyển yêu cầu<br>===================================="]
    INFO_PKG -- Chọn Gói dịch vụ --> DEC_SERVICE{{"Gói dịch vụ<br>"}}
    
    %% ==========================================
    %% NHÁNH 1 — EXPRESS (GIAO HỎA TỐC GIAO THẲNG)
    %% ==========================================
    DEC_SERVICE -- Express --> SHIPPER_EX["SHIPPER (ON_DEMAND)"]
    SHIPPER_EX -- SHIPPER: Đến lấy & Chở thẳng tới người nhận --> SCAN_EX["SHIPPER xác nhận giao hàng thành công<br>====================================<br>   · Quét mã xác nhận đơn hàng<br>   · Chụp ảnh bằng chứng (POD)<br>   · Thu số tiền COD từ Người nhận<br>===================================="]
    SCAN_EX -- Hoàn tất --> DONE_EX["GIAO THÀNH CÔNG — EXPRESS"]
    
    %% ==========================================
    %% NHÁNH 2 — STANDARD / SAVING (CHUYỂN PHÁT QUA KHO)
    %% ==========================================
    DEC_SERVICE -- Standard --> DEC_PICKUP{{"Customer chọn hình thức gửi hàng<br>"}}
    DEC_PICKUP -- Pickup: SHIPPER đến lấy tận nhà --> SHIPPER_A["SHIPPER (Lấy hàng)"]
    SHIPPER_A -- SHIPPER: Đến nhà khách · Quét mã xác nhận lấy hàng --> SCAN_A["SHIPPER quét mã xác nhận tại nhà Khách<br>====================================<br>   · Quét QR / Barcode trên kiện hàng<br>   · Chụp ảnh xác nhận đã lấy hàng từ Khách<br>===================================="]
    DEC_PICKUP -- Drop-off: Tự mang ra Bưu cục --> KH2["CUSTOMER"]
    KH2 -- CUSTOMER: Mang hàng ra Bưu cục gửi --> NV_BC2["STAFF (Bưu cục gửi cấp 3)"]
    SCAN_A -- SHIPPER: Chuyển hàng về Bưu cục gửi cấp 3 --> NV_BC2
    NV_BC2 -- STAFF: Quét Barcode tiếp nhận và phân loại --> SCAN_KHO["STAFF quét mã tiếp nhận &amp; Phân loại kho<br>====================================<br>   · Quét Barcode bưu kiện nhập bưu cục cấp 3<br>   · Hệ thống hiển thị khu vực để hàng<br>===================================="]
    SCAN_KHO -- Tự động xác định Hướng tuyến phân loại --> DEC_TUYEN{{"Phạm vi<br>giao hàng?"}}

    %% ==========================================
    %% QUY TRÌNH CHUẨN TRUNG CHUYỂN GIỮA CÁC KHO
    %% ==========================================

    %% CASE 1: CÙNG PHƯỜNG / XÃ
    DEC_TUYEN -- "1. Cùng Phường / Xã<br>BC gửi cấp 3 sang BC nhận cấp 3" --> WARD_L1["Bưu cục Phường gửi (BC Cấp 3)"]
    WARD_L1 -- "STAFF: Quét xuất Bưu cục Phường gửi" --> L1_STAFF_OUT["STAFF quét xuất bưu cục cấp 3"]
    L1_STAFF_OUT -- "SHIPPER: Quét xác nhận nhận bưu kiện" --> L1_DRIVER_IN["SHIPPER quét xác nhận lên xe"]
    L1_DRIVER_IN -- "Chuyển thẳng sang BC nhận cấp 3" --> C3_DST["Bưu cục Phường nhận (BC Cấp 3)"]

    %% CASE 2: KHÁC PHƯỜNG / XÃ NHƯNG CÙNG TỈNH / THÀNH PHỐ
    DEC_TUYEN -- "2. Khác Phường / Xã nhưng Cùng Tỉnh / TP<br>BC gửi cấp 3 sang BC cấp 2 về BC nhận cấp 3" --> WARD_L2["Bưu cục Phường gửi (BC Cấp 3)"]
    WARD_L2 -- "STAFF xuất Phường" --> L2_STAFF_OUT1["STAFF quét xuất BC gửi cấp 3"]
    L2_STAFF_OUT1 -- "SHIPPER LINEHAUL xác nhận lên xe" --> L2_DRIVER1["SHIPPER LINEHAUL quét xác nhận chở lên BC cấp 2"]
    L2_DRIVER1 -- "Chở đến BC cấp 2" --> PROV_L2["Kho Tổng Tỉnh (BC Cấp 2)"]
    PROV_L2 -- "STAFF xuất Kho Tỉnh" --> L2_STAFF_OUT2["STAFF quét xuất BC cấp 2"]
    L2_STAFF_OUT2 -- "SHIPPER LINEHAUL xác nhận chở về Phường" --> L2_DRIVER2["SHIPPER LINEHAUL quét xác nhận chở về BC nhận cấp 3"]
    L2_DRIVER2 -- "Chở về BC nhận cấp 3" --> C3_DST_PROV["Bưu cục Phường nhận (BC Cấp 3)"]

    %% CASE 3: KHÁC TỈNH / THÀNH PHỐ NHƯNG CÙNG MIỀN
    DEC_TUYEN -- "3. Khác Tỉnh / Thành phố nhưng Cùng Miền<br>BC gửi cấp 3 sang BC cấp 2 gửi qua BC cấp 1 về BC cấp 2 nhận sang BC nhận cấp 3" --> WARD_L3["Bưu cục Phường gửi (BC Cấp 3)"]
    WARD_L3 -- "STAFF xuất Phường" --> L3_STAFF_OUT1["STAFF quét xuất BC gửi cấp 3"]
    L3_STAFF_OUT1 -- "SHIPPER LINEHAUL xác nhận lên xe" --> L3_DRIVER1["SHIPPER LINEHAUL quét xác nhận chở lên BC cấp 2 gửi"]
    L3_DRIVER1 -- "Chở đến BC cấp 2 gửi" --> PROV_L3_SRC["Kho Tổng Tỉnh gửi (BC Cấp 2)"]
    
    PROV_L3_SRC -- "STAFF xuất Kho Tỉnh gửi" --> L3_STAFF_OUT2["STAFF quét xuất BC cấp 2 gửi"]
    L3_STAFF_OUT2 -- "SHIPPER LINEHAUL xác nhận đi BC cấp 1" --> L3_DRIVER2["SHIPPER LINEHAUL quét xác nhận xe tải đi BC Phân Loại cấp 1"]
    L3_DRIVER2 -- "Chở đến BC Phân Loại cấp 1" --> SORT_L3["Kho Phân Loại Miền (BC Cấp 1)"]

    SORT_L3 -- "STAFF phân loại & xuất Kho Miền" --> L3_STAFF_OUT3["STAFF quét xuất BC Phân Loại cấp 1"]
    L3_STAFF_OUT3 -- "SHIPPER LINEHAUL xác nhận sang BC cấp 2 nhận" --> L3_DRIVER3["SHIPPER LINEHAUL quét xác nhận chở sang BC cấp 2 nhận"]
    L3_DRIVER3 -- "Chở đến BC cấp 2 nhận" --> PROV_L3_DST["Kho Tổng Tỉnh nhận (BC Cấp 2)"]

    PROV_L3_DST -- "STAFF xuất Kho Tỉnh nhận" --> L3_STAFF_OUT4["STAFF quét xuất BC cấp 2 nhận"]
    L3_STAFF_OUT4 -- "SHIPPER LINEHAUL xác nhận chở về Phường" --> L3_DRIVER4["SHIPPER LINEHAUL quét xác nhận chở hàng về BC nhận cấp 3"]
    L3_DRIVER4 -- "Chở đến BC nhận cấp 3" --> C3_DST_REGION["Bưu cục Phường nhận (BC Cấp 3)"]

    %% CASE 4: KHÁC MIỀN (MIỀN NAM SANG MIỀN BẮC)
    DEC_TUYEN -- "4. Khác Miền (Miền Nam sang Miền Bắc)<br>BC gửi cấp 3 sang BC cấp 2 gửi qua BC nguồn cấp 1 -> BC Đích cấp 1 về BC cấp 2 sang BC nhận cấp 3" --> WARD_L4["Bưu cục Phường gửi (BC Cấp 3)"]
    WARD_L4 -- "STAFF xuất Phường" --> L4_STAFF_OUT1["STAFF quét xuất BC gửi cấp 3"]
    L4_STAFF_OUT1 -- "SHIPPER LINEHAUL xác nhận lên xe" --> L4_DRIVER1["SHIPPER LINEHAUL quét xác nhận chở lên BC cấp 2 gửi"]
    L4_DRIVER1 -- "Chở đến BC cấp 2 gửi" --> PROV_L4_SRC["Kho Tổng Tỉnh gửi (BC Cấp 2)"]

    PROV_L4_SRC -- "STAFF xuất Kho Tỉnh gửi" --> L4_STAFF_OUT2["STAFF quét xuất BC cấp 2 gửi"]
    L4_STAFF_OUT2 -- "SHIPPER LINEHAUL xác nhận đi BC cấp 1 Nguồn" --> L4_DRIVER2["SHIPPER LINEHAUL quét xác nhận xe tải đi BC Miền Nguồn cấp 1"]
    L4_DRIVER2 -- "Chở đến BC Miền Nguồn cấp 1" --> SORT_L4_SOUTH["Kho Phân Loại Miền Nguồn (BC Cấp 1)"]

    SORT_L4_SOUTH -- "STAFF phân loại & xuất Kho Miền Nguồn" --> L4_STAFF_OUT3["STAFF quét xuất BC Miền Nguồn cấp 1"]
    L4_STAFF_OUT3 -- "SHIPPER LINEHAUL xác nhận vận chuyển Liên miền" --> L4_DRIVER3["SHIPPER LINEHAUL quét xác nhận lên xe Container / Hàng không"]
    L4_DRIVER3 -- "Chuyển sang BC Miền Đích cấp 1" --> SORT_L4_NORTH["Kho Phân Loại Miền Đích (BC Cấp 1)"]

    SORT_L4_NORTH -- "STAFF phân loại & xuất Kho Miền Đích" --> L4_STAFF_OUT4["STAFF quét xuất BC Miền Đích cấp 1"]
    L4_STAFF_OUT4 -- "SHIPPER LINEHAUL xác nhận sang BC cấp 2 nhận" --> L4_DRIVER4["SHIPPER LINEHAUL quét xác nhận chở sang BC cấp 2 nhận"]
    L4_DRIVER4 -- "Chở đến BC cấp 2 nhận" --> PROV_L4_DST["Kho Tổng Tỉnh nhận (Hà Nội)<br>PROVINCIAL_HUB"]

    PROV_L4_DST -- "STAFF xuất Kho Tỉnh nhận" --> L4_STAFF_OUT5["STAFF quét xuất BC cấp 2 nhận"]
    L4_STAFF_OUT5 -- "SHIPPER LINEHAUL xác nhận chở về Phường" --> L4_DRIVER5["SHIPPER LINEHAUL quét xác nhận chở hàng về BC nhận cấp 3"]
    L4_DRIVER5 -- "Chở đến BC nhận cấp 3" --> C3_DST_CROSS["Bưu cục Phường nhận (Cầu Giấy)<br>WARD_STATION"]

    %% ==========================================
    %% PHASE 5 — GIAO HÀNG CHẶNG CUỐI
    %% ==========================================
    C3_DST -- "STAFF: Quét nhập bưu cục đích cấp 3 & Gán đơn" --> SHIPPER_L["SHIPPER (Chặng cuối BC cấp 3)"]
    C3_DST_PROV -- "STAFF: Quét nhập bưu cục đích cấp 3 & Gán đơn" --> SHIPPER_L
    C3_DST_REGION -- "STAFF: Quét nhập bưu cục đích cấp 3 & Gán đơn" --> SHIPPER_L
    C3_DST_CROSS -- "STAFF: Quét nhập bưu cục đích cấp 3 & Gán đơn" --> SHIPPER_L

    SHIPPER_L -- "SHIPPER: Đến địa chỉ người nhận" --> SCAN_GIAO["SHIPPER xác nhận giao hàng thành công<br>====================================<br>   · Quét mã xác nhận<br>   · Chụp ảnh bằng chứng (POD)<br>   · Thu số tiền COD từ Người nhận<br>===================================="]
    SCAN_GIAO -- Hoàn tất --> DONE["GIAO THÀNH CÔNG — STANDARD"]

    subgraph LEGEND["Chú thích Bưu cục"]
        BC_CAP3["Cấp 3: Phường / Xã"]
        BC_CAP2["Cấp 2: Kho Tỉnh / TP"]
        BC_CAP1["Cấp 1: Kho Miền Sorter"]
    end

