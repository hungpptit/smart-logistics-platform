PORT=5000
NODE_ENV=development

# Chuỗi kết nối đúng định dạng của Prisma ORM trỏ vào Docker
DATABASE_URL="postgresql://postgres:admin_password@localhost:5432/smart_logistics_db?schema=public"

# Cấu hình Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# JWT & Map API Key
JWT_SECRET=smart_logistics_secret_key_2026
MAP_API_KEY=your_google_maps_key_here

# NVIDIA NIM AI Service (Nemotron 3.5 Super VL 120B & Nemotron Embed 8B)
NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_CHAT_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
NVIDIA_EMBED_MODEL="nvidia/nemotron-3.5-embed-8b"
NVIDIA_API_KEY="your_nvidia_api_key_here"


